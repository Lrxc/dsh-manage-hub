{
  "name": "dsh-manage-hub",
  "version": "0.1.0",
  "description": "DeepSeek Harness web plugin: settings pages for managing user skills and MCP servers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lrxc/dsh-manage-hub.git"
  },
  "homepage": "https://github.com/Lrxc/dsh-manage-hub#readme",
  "bugs": {
    "url": "https://github.com/Lrxc/dsh-manage-hub/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "images",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "yaml": "^2.4.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "mcp"
  ],
  "license": "MIT"
}
