{
  "name": "dsh-manage-hub",
  "version": "0.1.0",
  "description": "DeepSeek Harness web plugin: settings pages for managing user skills and MCP servers",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
